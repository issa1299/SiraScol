# Copier ce fichier en .env et adapter (ne jamais committer .env)

# Clé secrète unique (générez avec: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SIRASCOL_SECRET_KEY=changez-moi-avec-une-cle-longue-et-aleatoire

# 0 = production, 1 = développement
SIRASCOL_DEBUG=0

# Domaines autorisés (séparés par des virgules)
SIRASCOL_ALLOWED_HOSTS=votre-ecole.com,www.votre-ecole.com

# Fuseau horaire
SIRASCOL_TIMEZONE=Africa/Bamako

# Derrière nginx avec HTTPS
SIRASCOL_BEHIND_PROXY=1
SIRASCOL_SSL_REDIRECT=1

# Durée de session en secondes (défaut 12h)
# SIRASCOL_SESSION_AGE=43200
